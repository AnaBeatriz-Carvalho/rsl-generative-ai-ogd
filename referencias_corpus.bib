@inproceedings{RobotStorytelling2025,
author = {Korpan, Raj and Ahmar, Khadeja and Jinnat, Raitah A. and Yee, Jackie},
title = {A Pilot Study of Robot Storytelling for Civic Data Literacy},
year = {2026},
isbn = {9798400723216},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez20.periodicos.capes.gov.br/10.1145/3776734.3794475},
doi = {10.1145/3776734.3794475},
abstract = {Cities release large volumes of open civic data, but many people lack the time or skills to interpret them. We report an exploratory pilot study examining whether a social robot can narrate stories derived from open civic data to support public understanding, trust, and data literacy. Our pipeline combines civic data analysis, large language model–based narrative generation, and scripted behaviors on the Misty II robot to produce expressive and neutral versions of two stories on noise complaints and COVID-19 trends. We deployed the system at a public event and collected post-interaction surveys from six adult participants. While the small sample size limits generalization, the pilot suggests that participants found the stories relevant and generally understood their main points, though engagement and enjoyment were mixed. Participant feedback highlighted the need for improved vocal prosody, reduced information density, and more interactivity. These findings provide initial feasibility evidence and design insights to inform future iterations of robot civic data storytelling systems.},
booktitle = {Companion Proceedings of the 21st ACM/IEEE International Conference on Human-Robot Interaction},
pages = {644–649},
numpages = {6},
keywords = {Civic Data, Data Literacy, Human-Robot Interaction, Public Interest Technology, Social Robots, Storytelling},
location = {Edinburgh, Scotland, UK},
series = {HRI Companion '26}
}

@inproceedings{ChatbotMadrid2021,
author = {Cantador, Iv\'{a}n and Viejo-Tard\'{\i}o, Jes\'{u}s and Cort\'{e}s-Cediel, Mar\'{\i}a E. and Rodr\'{\i}guez Bol\'{\i}var, Manuel Pedro},
title = {A Chatbot for Searching and Exploring Open Data: Implementation and Evaluation in E-Government},
year = {2021},
isbn = {9781450384926},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez20.periodicos.capes.gov.br/10.1145/3463677.3463681},
doi = {10.1145/3463677.3463681},
abstract = {In this paper, we present a chatbot to access open government data. Differently to similar systems reported in the research literature, the developed chatbot not only allows searching for data collections, but also exploring information within the collections. The exploration is done via complex queries that are easily built by non-expert users through a natural language conversation. Moreover, as another novel, differentiating contribution, we report a conducted user study aimed to evaluate the chatbot according to the achievement of a number of public service values, as well as measuring distinct objective and subjective metrics. Experimental results show that the proposed system outperforms traditional methods followed in open data portals.},
booktitle = {Proceedings of the 22nd Annual International Conference on Digital Government Research},
pages = {168–179},
numpages = {12},
keywords = {chatbots, e-government, open data, open government, public values},
location = {Omaha, NE, USA},
series = {dg.o '21}
}

@CONFERENCE{Dineva2025,
	author = {Dineva, Kristina and Atanasova, Tatiana},
	title = {A CLOUD-BASED ARCHITECTURE FOR AUTOMATED DATA EXTRACTION AND INTEGRATION FROM MULTIPLE GOVERNMENT SOURCES},
	year = {2025},
	journal = {International Multidisciplinary Scientific GeoConference Surveying Geology and Mining Ecology Management, SGEM},
	volume = {25},
	number = {4.2},
	pages = {891 - 897},
	doi = {10.5593/sgem2025v/4.2/s21.96.1},
	url = {https://www.scopus.com/pages/publications/105040144906?origin=resultslist},
	abstract = {This article presents a technological approach to extract and combine data from government websites to facilitate access to disparate information and obtain valuable analysis on it in response to user queries. The study addresses the challenges of extracting information from complex government sources, which often contain regulatory documents in various formats. The lack of open access complicates data consolidation, leading to fragmented search and analysis processes. Data scraping is proposed as a solution, but it faces issues such as complex site hierarchies, diverse formats, and inconsistent data structures. The paper outlines a method to create a centralized data repository in the cloud, regularly updated for training large language models (LLMs). The process begins with a Python scraper that collects various document types, which are then processed and stored in an S3 bucket. The final output allows users to interact with an LLM interface for specific queries, significantly improving access to public information and reducing bureaucratic burdens. The architecture developed enables automated and scalable data storage from multiple government sources. © 2025 International Multidisciplinary Scientific Geoconference. All rights reserved.},
	author_keywords = {AWS Cloud; government websites; LLM; Python scraper; S3 Bucket},
	keywords = {Clouds; Computer architecture; Data integration; Data mining; Digital storage; Extraction; Government data processing; Information retrieval systems; Open access; Python; Websites; Automated data; AWS cloud; Cloud-based architectures; Data extraction; Government websites; Language model; Large language model; Python scraper; S3 bucket; User query; Tools},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Ingole2024,
	author = {Ingole, Balaji Shesharao and Ramineni, Vishnu and Jayaram, Vivekananda and Pandy, Gokul and Krishnappa, Manjunatha Sughaturu and Parlapalli, Vidyasagar and Mullankandy, Sreeram and Banarse, Amey Ram},
	title = {AI Chatbot Implementation on Government Websites: A Framework for Development, User Engagement, and Security for DHS Website},
	year = {2024},
	journal = {2024 International Conference on Intelligent Cybernetics Technology and Applications, ICICyTA 2024},
	pages = {377 - 382},
	doi = {10.1109/ICICYTA64807.2024.10912857},
	url = {https://www.scopus.com/pages/publications/105001660642?origin=resultslist},
	abstract = {As digital transformation reshapes public services, the integration of AI-driven chatbots on government websites has emerged as a promising solution to streamline user support and enhance accessibility. This paper presents a comprehensive framework for implementing an AI chatbot on the Department of Health service (DHS) website, targeting the efficient resolution of diverse user needs while addressing the unique security challenges inherent in government digital infrastructure. The proposed framework covers critical aspects of chatbot development, including the configuration of natural language processing (NLP) models, user intent mapping, and data protection strategies tailored to sensitive government information. Additionally, it explores strategies to ensure user engagement and accessibility, considering the diverse demographics of DHS website visitors. This paper examines potential security risks, such as data breaches and unauthorized access and mentions best practices to deal with these issues. The framework offers a pathway to balance the dual objectives of responsive service and robust cybersecurity, ultimately advancing the role of AI in enhancing the accessibility and security of government services. The deployment of AI chatbots in public service contexts requires meticulous planning to align with legal and regulatory standards, particularly in managing sensitive health data. This study emphasizes the importance of ongoing monitoring and adaptive learning mechanisms to keep the chatbot updated with evolving public policies and user needs.  © 2024 IEEE.},
	author_keywords = {AI chatbot; department of health service (DHS); government websites; natural language processing (NLP); user engagement},
	keywords = {Artificial intelligence; Cybersecurity; Electronic health record; Government data processing; Metadata; Natural language processing systems; Sensitive data; Web services; AI chatbot; Chatbots; Department of health service; Department of healths; Government websites; Health services; Language processing; Natural language processing; Natural languages; User engagement; Websites},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@CONFERENCE{Nagesh2025,
	author = {Nagesh, H.R. and Ravinarayana, B. and Rai, Prakhyath},
	title = {An Ai Powered Information Assistant for Government Schemes - Development and Comparative Analysis},
	year = {2025},
	journal = {2025 IEEE International Conference on Emerging Trends in Computing and Communication, ETCOM 2025},
	pages = {},
	doi = {10.1109/ETCOM66606.2025.11436972},
	url = {https://www.scopus.com/pages/publications/105037328280?origin=resultslist},
	abstract = {An AI-powered information assistant -Abhiyan is developed to streamline access to government schemes, especially for rural users who may lack technical knowledge. Its core purpose is to simplify data retrieval, enhancing information accessibility and bridging the digital divide. Utilizing advanced Natural Language Processing (NLP) and Large Language Models (LLMs), the developed chatbot can understand user queries, including those in regional languages, to provide relevant, userfriendly responses. Abhiyan leverages a Retrieval-Augmented Generation (RAG) framework, enabling it to pull real-time information from structured government notices and documents. By preprocessing and organizing data on various schemes, the system ensures accurate and efficient response delivery, addressing common inquiries like eligibility criteria and application processes. This work integrates LLMs for natural language understanding with RAG for data retrieval, creating a platform that promotes digital inclusion. Abhiyan's scalable infrastructure and ability to offer real-time updates make it a powerful tool for citizens and government agencies alike, empowering users with timely access to essential information on government schemes. © 2025 IEEE.},
	author_keywords = {Artificial Intelligence; Chat-bot; Digital Illiteracy; Government Schemes; Large Language Model (LLM); Recommendation},
	keywords = {Government data processing; Information retrieval; Information systems; Knowledge management; Natural language processing systems; Chat bots; Comparative analyzes; Data retrieval; Digital illiteracy; Government scheme; Information accessibility; Language model; Large language model; Recommendation; Rural users; Artificial intelligence},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

